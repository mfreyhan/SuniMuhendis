# Copy this file to `.env` and fill in the keys you need:
#   cp .env.example .env
# `.env` is git-ignored.

# OpenRouter — the primary provider for benchmarks.
# Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional alternative providers.
# Hugging Face Inference Providers — https://huggingface.co/settings/tokens
# (needs the "Make calls to Inference Providers" permission)
HF_TOKEN=
OPENCODE_API_KEY=
